# Docker Compose example only. Copy to ignored .env.production and replace every placeholder.
# For Render/Vercel, configure service variables described in README.md instead.
DJANGO_SECRET_KEY=replace-with-python-secrets-token-url-safe-50
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=portal.example.com
DATABASE_URL=postgresql://portal_user:replace-with-a-unique-postgres-password@database:5432/portal?sslmode=disable
DJANGO_ENV=production
POSTGRES_DB=portal
POSTGRES_USER=portal_user
POSTGRES_PASSWORD=replace-with-a-unique-postgres-password
DJANGO_MEDIA_ROOT=/app/media
CORS_ALLOWED_ORIGINS=https://portal.example.com
CSRF_TRUSTED_ORIGINS=https://portal.example.com
TRUST_PROXY_SSL_HEADER=True
API_NUM_PROXIES=2
VITE_API_BASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
